# Maintainer: kagehiko
# Runtime requirement: the `fx` CLI (https://fx.sh), installed and signed in. It is not a pacman package.
pkgname=ask
pkgver=0.1.0
pkgrel=1
pkgdesc='Raycast-style Ask AI popup for Omarchy, backed by the fx CLI'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/ask "$pkgdir/usr/bin/ask"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/ask.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ask.svg"
  install -Dm644 "$startdir/ask.desktop" "$pkgdir/usr/share/applications/ask.desktop"
}
